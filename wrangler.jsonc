{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "docs-gosaad",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "docs.gosaad.id",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-07-26",
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page"
  }
}
